{
  "name": "silamoney/php-sdk",
  "description": "Sila PHP SDK for API Version 0.2",
  "version": "1.3.0",
  "keywords": [
    "sila",
    "payments",
    "ach",
    "credit",
    "fintech",
    "finance"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "José Morales",
      "email": "jmorales@digitalgeko.com",
      "role": "Developer"
    },
    {
      "name": "Karlo Lorenzana",
      "email": "klorenzana@digitalgeko.com",
      "role": "Developer"
    },
    {
      "name": "Carlos Sosa",
      "email": "csosa@digitalgeko.com",
      "role": "Developer"
    },
    {
      "name": "Alanfer Orozco",
      "email": "aorozco@digitalgeko.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-gmp": "*",
    "guzzlehttp/guzzle": "^8.3",
    "jms/serializer": "^3.32",
    "respect/validation": "^2.5",
    "kornrunner/secp256k1": "^0.4",
    "kornrunner/keccak": "^1.1",
    "myclabs/php-enum": "^1.8",
    "sop/asn1": "^4.1",
    "sop/crypto-encoding": "^0.3",
    "sop/crypto-types": "^0.3",
    "ext-openssl": "*"
  },
  "require-dev": {
    "ext-xdebug": "*",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "scripts": {
    "lint": [
      "@lint:lib",
      "@lint:test"
    ],
    "lint:lib": "phpcs --standard=PSR12 lib",
    "lint:test": "phpcs --standard=PSR12 test",
    "lint:autofix": [
      "@lint:autofix:lib",
      "@lint:autofix:test"
    ],
    "lint:autofix:lib": "phpcbf --standard=PSR12 lib",
    "lint:autofix:test": "phpcbf --standard=PSR12 test",
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit"
    ],
    "test:coverage": "@test --log-junit build/test-junit.xml --coverage-clover build/coverage-clover.xml",
    "test:coverage:human": "@test --coverage-html ./build/coverage-report"
  },
  "autoload": {
    "psr-4": {
      "Silamoney\\Client\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Silamoney\\Client\\": "test/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  }
}
